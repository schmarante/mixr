---
import '../styles/global.css';
import { getLocale, translate } from '../i18n';
import { requestLanguage } from '../i18n/server';
import { withBase } from '../lib/paths';

interface Props {
  title?: string;
  description?: string;
}

const lang = requestLanguage(Astro);
// Antwort hängt von Sprache ab (Cookie/Accept-Language) – für Caches kennzeichnen.
// Statisch vorgerendert (GitHub Pages) wählt der Browser die Sprache (data-lang-source fehlt dann).
if (!Astro.isPrerendered) Astro.response.headers.set('Vary', 'Accept-Language, Cookie');
const langSource = Astro.isPrerendered ? undefined : 'request';
const {
  title = translate(lang, 'common.meta.title'),
  description = translate(lang, 'common.meta.description'),
} = Astro.props;

// Link-Vorschau (Open Graph / Twitter): absolute URLs nur mit `site` (SITE_URL beim Build)
const abs = (path: string) => (Astro.site ? new URL(withBase(path), Astro.site).href : withBase(path));
---

<!doctype html>
<html lang={lang} data-lang-source={langSource} class="h-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#10131a" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={getLocale(lang).replace('-', '_')} />
    <meta property="og:site_name" content="strudelmixr" />
    <meta property="og:url" content={abs('')} />
    <meta property="og:image" content={abs('og-image.png')} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={translate(lang, 'common.meta.ogImageAlt')} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href={withBase('favicon.svg')} />
    <link rel="icon" href={withBase('favicon.ico')} sizes="32x32" />
    <title>{title}</title>
  </head>
  <body class="h-full overflow-hidden">
    <slot />
  </body>
</html>
